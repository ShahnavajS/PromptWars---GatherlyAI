# ============================================================
# Gatherly AI — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must NOT be committed.
# ============================================================

# ------------------------------------------------------------
# Google Gemini API Key (required for AI planning features)
# ------------------------------------------------------------
# Obtain from: https://aistudio.google.com/app/apikey
# Without this key, Gatherly falls back to deterministic
# starter templates — all functionality still works, but
# AI-personalised suggestions will not be generated.
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------
# Gemini model override (optional)
# ------------------------------------------------------------
# Default: gemini-2.5-flash
# Change only if you want to target a different model version.
# GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# SQLite database file path (optional)
# ------------------------------------------------------------
# Default: ./data/gatherly.db (relative to project root)
# The data/ directory is git-ignored.
# DATABASE_URL=./data/gatherly.db

# ------------------------------------------------------------
# Session authentication secret (REQUIRED in production)
# ------------------------------------------------------------
# Generate a strong random value: openssl rand -base64 32
# Must be at least 32 characters. Changing this value
# invalidates all existing sessions.
AUTH_SECRET=replace-with-a-32-plus-character-random-secret-value

# Set to "true" only on explicitly labelled demo deployments.
# In production, leave this unset or set to "false".
# ALLOW_DEMO_AUTH=false
